{
  "name": "orchestra",
  "version": "1.0.0",
  "description": "Local-first workflow orchestration desktop tool",
  "license": "MIT",
  "author": "Jaison D'souza",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsndz/orchestra.git"
  },
  "homepage": "https://github.com/jsndz/orchestra#readme",
  "bugs": {
    "url": "https://github.com/jsndz/orchestra/issues"
  },
  "keywords": [
    "orchestra",
    "workflow",
    "dag",
    "local-first",
    "mcp",
    "model-context-protocol",
    "electron",
    "developer-tools",
    "automation"
  ],
  "type": "module",
  "main": "packages/electron/dist/main.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "shared:build": "tsc -p packages/shared",
    "mcp-cli:build": "npm run shared:build && tsc -p packages/mcp-cli",
    "electron:build": "npm run shared:build && tsc -p packages/electron",
    "electron:watch": "tsc -w -p packages/electron",
    "client:dev": "npm run dev -w @orchestra/client",
    "client:build": "npm run build -w @orchestra/client",
    "web:dev": "npm run dev -w @orchestra/web",
    "web:build": "npm run build -w @orchestra/web",
    "dev": "npm run dev -w @orchestra/client",
    "build": "npm run shared:build && npm run mcp-cli:build && npm run electron:build && npm run client:build",
    "start": "npm run electron:build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "npm run shared:build && npm run mcp-cli:build && npm run electron:build && node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/express": "^5.0.6",
    "child_process": "^1.0.2",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "strip-ansi": "^7.2.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.orchestra.app",
    "asar": true,
    "productName": "Orchestra",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "packages/electron/dist/**/*",
      "packages/electron/preload.js",
      "packages/mcp-cli/dist/**/*",
      "packages/client/dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    }
  },
  "allowScripts": {
    "electron@41.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.21.5": true,
    "msw@2.15.0": true,
    "node-pty@1.1.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
